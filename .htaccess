# FORME ART — Apache-instellingen voor TransIP webhosting.
# Dit bestand hoort in de map www/ naast index.html.

AddDefaultCharset UTF-8
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. artpiece.nl (zonder www) -> https://www.artpiece.nl
  RewriteCond %{HTTP_HOST} ^artpiece\.nl$ [NC]
  RewriteRule ^ https://www.artpiece.nl%{REQUEST_URI} [L,R=301]

  # 2. http -> https (werkt ook achter de TransIP-proxy, zonder redirect-loop)
  RewriteCond %{HTTP_HOST} ^www\.artpiece\.nl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.artpiece.nl%{REQUEST_URI} [L,R=301]

  # Nette URL's: /golden-tide-i werkt ook zonder .html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# Browsercache: afbeeldingen lang, HTML kort.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compressie
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
